generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleCategory {
  SPORTIVA
  SUV_PERFORMANCE
  HYPERCAR
  CLASSIC
  GRAND_TOURER
  ELECTRIC_PRECISION
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_INSPECTION
  COMING_SOON
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

enum AppointmentType {
  VIP_TEST_DRIVE
  SALONE_VISIT
  TRADE_IN_EVALUATION
  FINANCIAL_CONSULTING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ValuationStatus {
  NEW
  IN_REVIEW
  OFFER_SENT
  ACCEPTED
  DECLINED
}

enum FinderStatus {
  NEW
  SEARCHING
  FOUND
  IMPORTED
  CANCELLED
}

model Vehicle {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  vin                  String            @unique
  brand                String
  model                String
  variant              String
  category             VehicleCategory

  // Prezzo & fiscalità
  priceChf             Int
  vatDeductible        Boolean           @default(false)

  // Storico & identificazione
  year                 Int
  mileage              Int
  firstRegistration    DateTime
  previousOwners       Int               @default(1)
  accidentFree         Boolean           @default(true)
  fullServiceHistory   Boolean           @default(true)
  mfkStatus            String?           // es. "Nuovo incluso" oppure "05/2025"

  // Dati tecnici
  horsepower           Int
  torqueNm             Int
  zeroToHundred        Float
  topSpeedKmh          Int
  rangeKm              Int?
  consumption          String?
  transmission         String            @default("Automatico")
  fuelType             String            @default("Benzina")
  drivetrain           String            @default("RWD")

  // Stato & media
  status               VehicleStatus     @default(AVAILABLE)
  heroImage            String
  gallery              String[]          @default([])
  videoUrl             String?
  description          String
  inspectionPdfUrl     String?

  // Relazioni
  upgradeSelections    VehicleUpgradeSelection[]
  bookings             VIPBooking[]

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([category])
  @@index([brand])
  @@index([status])
}

model UpgradeCategory {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  options UpgradeOption[]
}

model UpgradeOption {
  id             String   @id @default(cuid())
  name           String
  slug           String
  priceChf       Int
  hexColor       String?
  categoryId     String
  category       UpgradeCategory @relation(fields: [categoryId], references: [id])
  vehicleOptions VehicleUpgradeOption[]

  @@unique([categoryId, slug])
}

model VehicleUpgradeSelection {
  id           String         @id @default(cuid())
  hashId       String         @unique
  vehicleId    String
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id])
  totalChf     Int
  createdAt    DateTime       @default(now())
  options      VehicleUpgradeOption[]
}

model VehicleUpgradeOption {
  id              String @id @default(cuid())
  selectionId     String
  optionId        String
  selection       VehicleUpgradeSelection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  option          UpgradeOption            @relation(fields: [optionId], references: [id])

  @@unique([selectionId, optionId])
}

model ValuationRequest {
  id            String          @id @default(cuid())
  fullName      String
  email         String
  phone         String
  contactMethod ContactMethod

  // Auto del cliente
  brand         String
  model         String
  year          Int
  mileage       Int
  plate         String?
  vin           String?
  conditionNotes String?
  photos        String[]        @default([])
  desiredPriceChf Int?

  status        ValuationStatus @default(NEW)
  createdAt     DateTime        @default(now())
}

model CarFinderRequest {
  id            String       @id @default(cuid())
  fullName      String
  email         String
  phone         String
  contactMethod ContactMethod

  // Ricerca desiderata
  brand         String
  model         String?
  yearFrom      Int?
  yearTo        Int?
  budgetMaxChf  Int
  preferredCategory VehicleCategory?
  notes         String?

  status        FinderStatus @default(NEW)
  createdAt     DateTime     @default(now())
}

model VIPBooking {
  id              String         @id @default(cuid())
  fullName        String
  email           String
  phone           String
  contactMethod   ContactMethod
  appointmentType AppointmentType
  preferredDate   DateTime
  preferredTime   String
  notes           String?
  vehicleId       String?
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id])
  status          BookingStatus  @default(PENDING)
  createdAt       DateTime       @default(now())

  @@index([status])
}