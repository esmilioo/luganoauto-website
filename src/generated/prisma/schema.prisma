generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VehicleCategory {
  HYPERCAR
  PERFORMANCE_SUV
  PURE_SPORT
  ELECTRIC_PRECISION
}

enum ContactMethod {
  WHATSAPP
  PHONE
  EMAIL
}

enum AppointmentType {
  VIP_TEST_DRIVE
  TRADE_IN_EVALUATION
  FINANCIAL_CONSULTING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Vehicle {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  brand          String
  model          String
  category       VehicleCategory
  horsepower     Int
  torqueNm       Int
  zeroToHundred  Float
  topSpeedKmh    Int
  rangeKm        Int?
  consumption    String?
  basePriceChf   Int
  available      Boolean                @default(true)
  heroImage      String
  description    String
  configurations VehicleConfiguration[]
  bookings       VIPBooking[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([category])
  @@index([brand])
}

model OptionCategory {
  id      String   @id @default(cuid())
  name    String
  slug    String   @unique
  options Option[]
}

model Option {
  id             String                       @id @default(cuid())
  name           String
  slug           String
  priceChf       Int
  hexColor       String?
  categoryId     String
  category       OptionCategory               @relation(fields: [categoryId], references: [id])
  configurations VehicleConfigurationOption[]

  @@unique([categoryId, slug])
}

model VehicleConfiguration {
  id              String                       @id @default(cuid())
  hashId          String                       @unique
  vehicleId       String
  vehicle         Vehicle                      @relation(fields: [vehicleId], references: [id])
  totalPriceChf   Int
  monthlyLeaseChf Int
  options         VehicleConfigurationOption[]
  bookings        VIPBooking[]
  createdAt       DateTime                     @default(now())
}

model VehicleConfigurationOption {
  id              String               @id @default(cuid())
  configurationId String
  optionId        String
  configuration   VehicleConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  option          Option               @relation(fields: [optionId], references: [id])

  @@unique([configurationId, optionId])
}

model VIPBooking {
  id              String                @id @default(cuid())
  fullName        String
  email           String
  phone           String
  contactMethod   ContactMethod
  appointmentType AppointmentType
  preferredDate   DateTime
  preferredTime   String
  notes           String?
  vehicleId       String?
  vehicle         Vehicle?              @relation(fields: [vehicleId], references: [id])
  configurationId String?
  configuration   VehicleConfiguration? @relation(fields: [configurationId], references: [id])
  status          BookingStatus         @default(PENDING)
  createdAt       DateTime              @default(now())

  @@index([status])
}
